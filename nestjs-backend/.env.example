# Runtime
NODE_ENV=development
PORT=3000

# Database — DB_HOST must be the Docker Compose service name, never localhost.
# Inside a container localhost resolves to the container itself.
DB_HOST=db
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

# Comma-separated list of allowed origins. Never "*".
CORS_ORIGIN=http://localhost:3001
