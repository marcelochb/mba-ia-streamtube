{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "@swc/jest"
    ]
  },
  "setupFiles": [
    "dotenv/config"
  ],
  "transformIgnorePatterns": [
    "node_modules/(?!(@nestjs/config|@nestjs/typeorm)/)"
  ]
}
